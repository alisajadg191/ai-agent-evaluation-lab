# These are shell environment variables. The CLI does not auto-load this file.
# Local evaluation needs no keys and does not upload to LangSmith.
LANGSMITH_API_KEY=
# For EU accounts: https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Only required when your API key needs an explicit workspace.
LANGSMITH_WORKSPACE_ID=
# Optional Ollama judge, enabled only by the CLI --judge-model flag.
OLLAMA_HOST=http://localhost:11434
